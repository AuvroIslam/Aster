# Copy to .env.local. Read by Next at build time, so it must be prefixed
# NEXT_PUBLIC_ to reach the browser.

# Where the Aster API is served from. Leave blank to use same-origin.
NEXT_PUBLIC_API_BASE=http://localhost:5174

# The public origin, used to build absolute share-preview image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
