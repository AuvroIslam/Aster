# Copy to .env (repo root) and fill in. Never commit the filled-in file.

# --- The model ------------------------------------------------------------
# Gemma is the only generative model. Everything Aster says comes from here.
GEMMA_API_KEY=
GEMMA_MODEL=auto
GEMMA_PROVIDER=google
GEMMA_CONCURRENCY=3

# --- Language -------------------------------------------------------------
# `auto` reads the video's own caption tracks and mirrors that language.
CAPTION_LANGS=auto
OUTPUT_LANG=auto

# --- Description pipeline -------------------------------------------------
MIN_GAP_SECONDS=1.2
MIN_SPACING_SECONDS=8
FORCED_CANDIDATE_INTERVAL=45
MAX_CANDIDATES=60
CONFIDENCE_HIGH=0.85
CONFIDENCE_CRITICAL=0.6
FRAME_WIDTH=640
MAX_VIDEO_HEIGHT=480

# --- Server ---------------------------------------------------------------
PORT=5174
# The Next dev server. Must match wherever the web app is served from.
CORS_ORIGIN=http://localhost:3000

# --- Voice ------------------------------------------------------------------
# Speech recognition and speech synthesis both run in the browser (Chrome or
# Edge). Nothing to configure, and no key: spoken search, spoken questions
# and spoken practice answers all work out of the box.
SEARCH_MAX_RESULTS=6

# --- yt-dlp (only needed on a datacenter IP) ------------------------------
YTDLP_PROXY=
YTDLP_COOKIES_PATH=
