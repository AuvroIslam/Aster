# Copy to .env.local and fill in. Never commit the filled-in file.

# The only generative model. Everything Aster says comes from here.
GEMMA_API_KEY=
GEMMA_MODEL=auto

# Where Gemma is served from: `google`, `featherless`, or `local`.
GEMMA_PROVIDER=google

# Point at a local runtime (Ollama, llama.cpp) to run with no API cost.
GEMMA_LOCAL_URL=http://localhost:11434

# Language of descriptions and answers. `auto` mirrors the narration.
OUTPUT_LANG=auto
CAPTION_LANGS=auto

# Optional: enables spoken video search. Text search works without it.
OPENAI_API_KEY=
