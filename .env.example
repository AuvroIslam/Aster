# Copy to .env (repo root) and fill in. Never commit the filled-in file.

# --- The model ------------------------------------------------------------
# Gemma is the only generative model. Every description, answer, question and
# summary comes from here.
#
# Three rungs, tried in order. Each covers a different failure, so filling in
# more than one is worth doing before a demo:
#
#   1. GEMMA_API_KEY           the main Google AI Studio key
#   2. GEMMA_API_KEY_FALLBACK  a second key on a DIFFERENT Google account —
#                              this is what covers the free tier's per-account
#                              rate limit, which is what actually runs out
#                              partway through a long video
#   3. FEATHERLESS_API_KEY     the same Gemma weights on another host, so an
#                              outage that takes out both Google keys at once
#                              still leaves Aster working
#
# Only the first is required. Free key: https://aistudio.google.com/apikey
GEMMA_API_KEY=
GEMMA_API_KEY_FALLBACK=

# Model id, or `auto` to let Aster pick the best Gemma your key can see.
GEMMA_MODEL=gemma-4-31b-it
GEMMA_MODEL_PREFERENCES=gemma-4-31b-it,gemma-4-26b-a4b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_CONCURRENCY=3

# `google` (default) uses the keys above and falls back to Featherless only if
# both fail. Set to `featherless` to use Featherless as the primary instead.
GEMMA_PROVIDER=google

# --- Featherless (rung 3, optional) ---------------------------------------
# Key: https://featherless.ai/account/api-keys
# Ids are case-sensitive and do not match AI Studio's casing — confirm one
# against GET /v1/models rather than copying it out of a blog post.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# --- Language -------------------------------------------------------------
# `auto` reads the video's own caption tracks and mirrors that language, so a
# Bengali lesson is described in Bengali.
CAPTION_LANGS=auto
OUTPUT_LANG=auto

# --- Description pipeline -------------------------------------------------
MIN_GAP_SECONDS=1.2
MIN_SPACING_SECONDS=8
FORCED_CANDIDATE_INTERVAL=45
MAX_CANDIDATES=60
CONFIDENCE_HIGH=0.85
CONFIDENCE_CRITICAL=0.6
FRAME_WIDTH=640
MAX_VIDEO_HEIGHT=480

# --- Server ---------------------------------------------------------------
PORT=5174
# The Next dev server. Must match wherever the web app is served from.
CORS_ORIGIN=http://localhost:3000

# --- Voice ----------------------------------------------------------------
# Speech recognition and speech synthesis both run in the browser (Chrome or
# Edge). Nothing to configure and no key: spoken search, spoken questions and
# spoken practice answers all work out of the box.
SEARCH_MAX_RESULTS=6

# --- yt-dlp (only needed on a hosted/datacenter IP) -----------------------
# YouTube blocks anonymous downloads from datacenter addresses. On a personal
# machine neither of these is needed. On a deployed instance, without them
# YouTube eventually refuses new videos and Aster says so plainly — the
# already-described lessons keep working either way.
#
# Netscape-format cookies.txt exported from a browser signed into a throwaway
# Google account. Never your primary one: this file is a live session.
YTDLP_COOKIES_PATH=
# A directory of cookies.txt files, tried in rotation as each gets bot-checked.
YTDLP_COOKIES_DIR=
# Egress proxy for every yt-dlp request. Addresses the cause rather than the
# symptom: the block is a judgement about the IP, not the session.
YTDLP_PROXY=
